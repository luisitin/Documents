{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "CAA Tracker base (strict; 07-implementation-plan.md ARCH-1)",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@caa/data-schemas/node": ["./packages/data-schemas/src/node"],
      "@caa/estimator/golden": ["./packages/estimator/src/golden"],
      "@caa/*": ["./packages/*/src"]
    }
  }
}
